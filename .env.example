# Copy file này thành .env trước khi `docker compose up`.
#
# Worker gọi model AI qua AWS Bedrock, xác thực bằng AWS credentials mount
# read-only từ ~/.aws trên host (xem docker-compose.yml) — KHÔNG dùng API key
# riêng. Cần đã chạy `aws configure` (hoặc SSO) trên máy host trước, và model
# bên dưới đã được enable trong Bedrock Model Access ở đúng region.

# Tên profile trong ~/.aws/credentials (hoặc ~/.aws/config nếu dùng SSO).
AWS_PROFILE=default

# Region đã enable model access cho Bedrock.
AWS_REGION=ap-southeast-1

# Model ID trên Bedrock (khác model ID của Anthropic API trực tiếp) — lấy từ
# `aws bedrock list-foundation-models --region $AWS_REGION` hoặc AWS Console.
#
# ap-southeast-1 (và nhiều region ngoài us-east-1/us-west-2) KHÔNG hỗ trợ
# on-demand throughput trực tiếp cho Claude 3.5 Sonnet — bắt buộc phải gọi qua
# "cross-region inference profile" (tiền tố "apac." cho khu vực APAC), nếu
# không sẽ gặp lỗi:
#   ValidationException: Invocation of model ID anthropic.claude-3-5-sonnet-...
#   with on-demand throughput isn't supported. Retry your request with the ID
#   or ARN of an inference profile that contains this model.
BEDROCK_MODEL_ID=apac.anthropic.claude-3-5-sonnet-20241022-v2:0
